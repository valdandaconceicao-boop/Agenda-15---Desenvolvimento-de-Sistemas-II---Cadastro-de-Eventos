<?xml version="1.0" encoding="utf-8" ?>

<!-- Esta é a página de resumo do evento -->
<!-- Ela mostra todos os dados que o usuário cadastrou de forma organizada e bonita -->
<!-- Também exibe os valores calculados: duração em dias e custo total -->

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Agenda_15___Desenvolvimento_de_Sistemas_II___Cadastro_de_Eventos.Models"
             x:Class="Agenda_15___Desenvolvimento_de_Sistemas_II___Cadastro_de_Eventos.Views.ResumoPage"
             Title="Resumo do Evento"
             BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#121212}">

    <!-- ScrollView permite rolar o conteúdo caso não caiba na tela -->
    <ScrollView>

        <!-- VerticalStackLayout organiza os cards um abaixo do outro -->
        <!-- x:DataType conecta com a classe Evento para os Bindings funcionarem -->
        <VerticalStackLayout Spacing="20" Padding="20" x:DataType="models:Evento">

            <!-- Card de destaque no topo com o nome e local do evento -->
            <!-- Tem fundo roxo para chamar atenção -->
            <Frame BackgroundColor="#512BD4" 
                   CornerRadius="12" 
                   HasShadow="True" 
                   BorderColor="Transparent"
                   Padding="20, 25">
                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">

                    <!-- Subtítulo "RESUMO DO EVENTO" -->
                    <Label Text="RESUMO DO EVENTO" 
                           TextColor="#D1C4E9" 
                           FontSize="12" 
                           FontAttributes="Bold" 
                           CharacterSpacing="1.5"
                           HorizontalOptions="Center" />

                    <!-- Mostra o nome do evento usando Binding -->
                    <!-- O valor vem da propriedade Nome do objeto Evento -->
                    <Label Text="{Binding Nome}" 
                           TextColor="White" 
                           FontSize="24" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />

                    <!-- Mostra o local do evento com um emoji de pin -->
                    <!-- StringFormat adiciona o emoji antes do texto do local -->
                    <Label Text="{Binding Local, StringFormat='📍 {0}'}" 
                           TextColor="#E1BEE7" 
                           FontSize="14" 
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Frame>

            <!-- Card do investimento total - mostra os custos calculados -->
            <Frame CornerRadius="12" 
                   HasShadow="True" 
                   BorderColor="Transparent"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                   Padding="20">
                <VerticalStackLayout Spacing="15" HorizontalOptions="FillAndExpand">

                    <!-- Título da seção -->
                    <Label Text="INVESTIMENTO TOTAL" 
                           TextColor="#6B7280" 
                           FontSize="11" 
                           FontAttributes="Bold" 
                           CharacterSpacing="1"
                           HorizontalOptions="Center" />
                    
                    <!-- Aqui mostra o CUSTO TOTAL calculado automaticamente -->
                    <!-- O Binding pega o valor da propriedade CustoTotal do Evento -->
                    <!-- CustoTotal é calculado multiplicando participantes pelo custo unitário -->
                    <!-- StringFormat formata o valor como moeda brasileira (R$ 1.500,00) -->
                    <Label Text="{Binding CustoTotal, StringFormat='R$ {0:N2}'}" 
                           TextColor="#10B981" 
                           FontSize="32" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center" />

                    <!-- Linha divisória para separar visualmente as informações -->
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E5E7EB, Dark=#2D2D2D}" Margin="0,5" />

                    <!-- Grid com duas colunas mostrando o custo individual e participantes -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">

                        <!-- Coluna esquerda: quanto cada pessoa paga -->
                        <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                            <Label Text="Custo por Pessoa" TextColor="#9CA3AF" FontSize="11" HorizontalOptions="Center" />
                            <!-- Binding pega CustoPorParticipante e formata como moeda -->
                            <Label Text="{Binding CustoPorParticipante, StringFormat='R$ {0:N2}'}" TextColor="{AppThemeBinding Light=#1F2937, Dark=#E5E7EB}" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        
                        <!-- Coluna direita: quantas pessoas participam -->
                        <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                            <Label Text="Participantes" TextColor="#9CA3AF" FontSize="11" HorizontalOptions="Center" />
                            <!-- Binding pega NumeroParticipantes e adiciona "pessoas" no final -->
                            <Label Text="{Binding NumeroParticipantes, StringFormat='{0} pessoas'}" TextColor="{AppThemeBinding Light=#1F2937, Dark=#E5E7EB}" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Card de duração e cronograma - mostra as datas e a duração calculada -->
            <Frame CornerRadius="12" 
                   HasShadow="True" 
                   BorderColor="Transparent"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                   Padding="20">
                <VerticalStackLayout Spacing="15">
                    
                    <!-- Título da seção -->
                    <Label Text="DURAÇÃO E CRONOGRAMA" 
                           TextColor="#6B7280" 
                           FontSize="11" 
                           FontAttributes="Bold" 
                           CharacterSpacing="1"
                           HorizontalOptions="Center" />

                    <!-- Grid com duas colunas para mostrar data de início e término -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,5">

                        <!-- Coluna esquerda: data de início formatada como dia/mês/ano -->
                        <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                            <Label Text="Data de Início" TextColor="#9CA3AF" FontSize="11" HorizontalOptions="Center" />
                            <Label Text="{Binding DataInicio, StringFormat='{0:dd/MM/yyyy}'}" TextColor="{AppThemeBinding Light=#1F2937, Dark=#E5E7EB}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <!-- Coluna direita: data de término formatada como dia/mês/ano -->
                        <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                            <Label Text="Data de Término" TextColor="#9CA3AF" FontSize="11" HorizontalOptions="Center" />
                            <Label Text="{Binding DataTermino, StringFormat='{0:dd/MM/yyyy}'}" TextColor="{AppThemeBinding Light=#1F2937, Dark=#E5E7EB}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Linha divisória -->
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E5E7EB, Dark=#2D2D2D}" Margin="0,5" />

                    <!-- Aqui mostra a DURAÇÃO calculada automaticamente -->
                    <!-- O Binding pega DuracaoDias, que é calculado usando DateTime e TimeSpan -->
                    <!-- A lógica faz: DataTermino - DataInicio = TimeSpan, e pega os .Days -->
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="Duração Total Calculada" TextColor="#9CA3AF" FontSize="11" HorizontalOptions="Center" />
                        <Label Text="{Binding DuracaoDias, StringFormat='{0} dias'}" 
                               TextColor="#3B82F6" 
                               FontSize="20" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

        <!-- Botão para voltar à tela de cadastro e registrar um novo evento -->
        <!-- Clicked define o método OnVoltarClicked que será chamado ao clicar -->
        <Button Text="NOVO CADASTRO"
                Clicked="OnVoltarClicked"
                BackgroundColor="{AppThemeBinding Light=#374151, Dark=#4B5563}"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="14"
                HeightRequest="48"
                CornerRadius="24"
                Margin="0,10,0,0" />

        <!-- Créditos do desenvolvedor -->
        <Label Text="Dev Valdan Conceição França"
               TextColor="#9CA3AF"
               FontSize="12"
               FontAttributes="Italic"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               Margin="0,10,0,10" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
